{
    "problem_data": {
        "start_time": 0.0,
        "end_time": 10.0,
        "echo_level": 0,
        "print_colors": true,
        "parallel_type": "OpenMP"
    },
    "solver_settings": {
        "type": "coupled_solvers.gauss_seidel_strong",
        "echo_level": 1,
        "num_coupling_iterations": 60,
        "predictors": [
            {
                "type": "linear_derivative_based",
                "solver": "fluid",
                "data_name": "disp",
                "derivative_data_name": "velocity"
            }
        ],
        "convergence_accelerators": [
            {
                "type": "constant_relaxation",
                "solver": "fluid",
                "data_name": "disp",
                "alpha": 0.03
            }
        ],
        "convergence_criteria": [
            {
                "type": "relative_norm_previous_residual",
                "solver": "fluid",
                "data_name": "disp",
                "abs_tolerance": 1e-06,
                "rel_tolerance": 1e-06
            }
        ],
        "data_transfer_operators": {
            "beam_mapper": {
                "type": "kratos_beam_mapping",
                "solver_name_beam": "structure",
                "solver_name_surface": "fluid",
                "model_part_name_beam": "Structure.Parts_Beam",
                "model_part_name_surface": "FluidModelPart.interface",
                "second_variable_displacement": "ROTATION",
                "second_variable_force": "POINT_MOMENT",
                "mapper_settings": {
                    "mapper_type": "beam_spline_mapper",
                    "search_settings": {
                        "search_radius": 0.01,
                        "max_num_search_iterations": 30
                    },
                    "local_coord_tolerance": 0.25,
                    "echo_level": 0
                }
            }
        },
        "coupling_operations": {
            "scale_fluid_reaction": {
                "type": "scaling",
                "solver": "fluid",
                "data_name": "load",
                "scaling_factor": 50.0
            }
        },
        "coupling_sequence": [
            {
                "name": "fluid",
                "input_data_list": [],
                "output_data_list": []
            },
            {
                "name": "structure",
                "input_data_list": [
                    {
                        "data": "load",
                        "from_solver": "fluid",
                        "from_solver_data": "load",
                        "data_transfer_operator": "beam_mapper",
                        "before_data_transfer_operations": [
                            "scale_fluid_reaction"
                        ],
                        "data_transfer_operator_options": [
                            "swap_sign"
                        ]
                    }
                ],
                "output_data_list": [
                    {
                        "data": "disp",
                        "to_solver": "fluid",
                        "to_solver_data": "disp",
                        "data_transfer_operator": "beam_mapper"
                    }
                ]
            }
        ],
        "solvers": {
            "fluid": {
                "type": "solver_wrappers.kratos.fluid_dynamics_wrapper",
                "solver_wrapper_settings": {
                    "input_file": "ProjectParametersCFD"
                },
                "data": {
                    "disp": {
                        "model_part_name": "FluidModelPart.interface",
                        "dimension": 2,
                        "variable_name": "MESH_DISPLACEMENT"
                    },
                    "velocity": {
                        "model_part_name": "FluidModelPart.interface",
                        "dimension": 2,
                        "variable_name": "VELOCITY"
                    },
                    "load": {
                        "model_part_name": "FluidModelPart.interface",
                        "dimension": 2,
                        "variable_name": "REACTION"
                    }
                }
            },
            "structure": {
                "type": "solver_wrappers.kratos.structural_mechanics_wrapper",
                "solver_wrapper_settings": {
                    "input_file": "ProjectParametersCSM"
                },
                "data": {
                    "disp": {
                        "model_part_name": "Structure.Parts_Beam",
                        "dimension": 3,
                        "variable_name": "DISPLACEMENT"
                    },
                    "load": {
                        "model_part_name": "Structure.Parts_Beam",
                        "dimension": 3,
                        "variable_name": "POINT_LOAD"
                    }
                }
            }
        }
    }
}
